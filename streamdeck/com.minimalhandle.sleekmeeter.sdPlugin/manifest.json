{
  "Name": "Sleekmeeter",
  "Version": "0.16.3.0",
  "Author": "minimalhandle",
  "Description": "Studio live controls for Sleekmeeter: channel and app volume dials, live meters, and Now Playing with Windows media-session artwork and timeline.",
  "Category": "Sleekmeeter",
  "CategoryIcon": "imgs/category",
  "Icon": "imgs/plugin",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "6.4"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Nodejs": {
    "Version": "20",
    "Debug": "enabled"
  },
  "UUID": "com.minimalhandle.sleekmeeter",
  "Actions": [
    {
      "Name": "Channel level",
      "UUID": "com.minimalhandle.sleekmeeter.channel",
      "Icon": "imgs/actions/channel",
      "Tooltip": "Turn the dial to change a channel's level. Press to mute.",
      "Controllers": [
        "Encoder"
      ],
      "PropertyInspectorPath": "ui/pi.html",
      "UserTitleEnabled": false,
      "Encoder": {
        "layout": "layouts/channel.json",
        "Icon": "imgs/keys/channel",
        "TriggerDescription": {
          "Rotate": "Change level",
          "Push": "Mute or unmute",
          "Touch": "Mute or unmute"
        }
      },
      "States": [
        {
          "Image": "imgs/keys/channel",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "Mute channel",
      "UUID": "com.minimalhandle.sleekmeeter.mute",
      "Icon": "imgs/actions/mute",
      "Tooltip": "Mute or unmute a channel. The key shows its level.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/pi.html",
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/keys/mute",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "Mute mic",
      "UUID": "com.minimalhandle.sleekmeeter.mic",
      "Icon": "imgs/actions/mic",
      "Tooltip": "Mute or unmute your microphone. Green means active; red with a slash means muted.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/pi.html",
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/keys/mic",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "Route to bus",
      "UUID": "com.minimalhandle.sleekmeeter.route",
      "Icon": "imgs/actions/route",
      "Tooltip": "Turn one of an input's A or B buses on or off, for example your mic to B3. The key lights up and pulses slowly while the route is on.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/pi.html",
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/keys/route",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "Swap route",
      "UUID": "com.minimalhandle.sleekmeeter.swap",
      "Icon": "imgs/actions/route",
      "Tooltip": "Switch between two routes with one press, for example which mic goes to B2, or whether your game plays on A1 or A2. One turns on as the other turns off.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/pi.html",
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/keys/route",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "Level step",
      "UUID": "com.minimalhandle.sleekmeeter.level",
      "Icon": "imgs/actions/level",
      "Tooltip": "Turn a channel up or down, or jump to a level.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/pi.html",
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/keys/level",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "Load scene",
      "UUID": "com.minimalhandle.sleekmeeter.scene",
      "Icon": "imgs/actions/scene",
      "Tooltip": "Load a Sleekmeeter scene.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/pi.html",
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/keys/scene",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "Play sound",
      "UUID": "com.minimalhandle.sleekmeeter.sound",
      "Icon": "imgs/actions/sound",
      "Tooltip": "Play a soundboard sound.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/pi.html",
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/keys/sound",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "Stop sounds",
      "UUID": "com.minimalhandle.sleekmeeter.soundstop",
      "Icon": "imgs/actions/soundstop",
      "Tooltip": "Stop every sound that is playing.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/pi.html",
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/keys/soundstop",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "Be right back",
      "UUID": "com.minimalhandle.sleekmeeter.brb",
      "Icon": "imgs/actions/brb",
      "Tooltip": "Turn Be right back on or off.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/pi.html",
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/keys/brb",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "Record",
      "UUID": "com.minimalhandle.sleekmeeter.record",
      "Icon": "imgs/actions/record",
      "Tooltip": "Start or stop the Voicemeeter recorder.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/pi.html",
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/keys/record",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "Talk-over ducking",
      "UUID": "com.minimalhandle.sleekmeeter.duck",
      "Icon": "imgs/actions/duck",
      "Tooltip": "Turn talk-over ducking on or off.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/pi.html",
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/keys/duck",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "Output profile",
      "UUID": "com.minimalhandle.sleekmeeter.output",
      "Icon": "imgs/actions/output",
      "Tooltip": "Switch to an output profile, or the next one.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/pi.html",
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/keys/output",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "Now Playing + channel",
      "UUID": "com.minimalhandle.sleekmeeter.nowplaying",
      "Icon": "imgs/actions/nowplaying",
      "Tooltip": "Album art, artist, elapsed and total time. Turn to adjust a Sleekmeeter channel, press to mute, tap to play or pause.",
      "Controllers": [
        "Encoder"
      ],
      "PropertyInspectorPath": "ui/pi.html",
      "UserTitleEnabled": false,
      "Encoder": {
        "layout": "layouts/channel.json",
        "TriggerDescription": {
          "Push": "Mute channel (configurable)",
          "Rotate": "Adjust channel level",
          "Touch": "Play / pause (configurable)"
        },
        "Icon": "imgs/keys/nowplaying"
      },
      "States": [
        {
          "ShowTitle": false,
          "Image": "imgs/keys/nowplaying"
        }
      ]
    },
    {
      "Name": "Now Playing key",
      "UUID": "com.minimalhandle.sleekmeeter.nowplayingkey",
      "Icon": "imgs/actions/nowplayingkey",
      "Tooltip": "Album art, title and track progress on a key. Press to play or pause.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/pi.html",
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/keys/nowplayingkey",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "Now Playing + tracks",
      "UUID": "com.minimalhandle.sleekmeeter.trackdial",
      "Icon": "imgs/actions/trackdial",
      "Tooltip": "Album art and track time. Turn to change track, press or tap to play or pause.",
      "Controllers": [
        "Encoder"
      ],
      "PropertyInspectorPath": "ui/pi.html",
      "UserTitleEnabled": false,
      "Encoder": {
        "layout": "layouts/channel.json",
        "Icon": "imgs/keys/trackdial",
        "TriggerDescription": {
          "Rotate": "Next or previous track",
          "Push": "Play / pause (configurable)",
          "Touch": "Play / pause (configurable)"
        }
      },
      "States": [
        {
          "Image": "imgs/keys/trackdial",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "App volume",
      "UUID": "com.minimalhandle.sleekmeeter.appvolume",
      "Icon": "imgs/actions/appvolume",
      "Tooltip": "Turn to change one app's volume, for example Discord or a game. Press or tap to mute it.",
      "Controllers": [
        "Encoder"
      ],
      "PropertyInspectorPath": "ui/pi.html",
      "UserTitleEnabled": false,
      "Encoder": {
        "layout": "layouts/channel.json",
        "Icon": "imgs/keys/appvolume",
        "TriggerDescription": {
          "Rotate": "Change app volume",
          "Push": "Mute or unmute app",
          "Touch": "Mute or unmute app"
        }
      },
      "States": [
        {
          "Image": "imgs/keys/appvolume",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "Output mix",
      "UUID": "com.minimalhandle.sleekmeeter.mixdial",
      "Icon": "imgs/actions/channel",
      "Tooltip": "Voicemeeter Potato: turn to set one input's level on one output, for example less game on your stream. Press or tap to match the input's main level.",
      "Controllers": [
        "Encoder"
      ],
      "PropertyInspectorPath": "ui/pi.html",
      "UserTitleEnabled": false,
      "Encoder": {
        "layout": "layouts/channel.json",
        "Icon": "imgs/keys/channel",
        "TriggerDescription": {
          "Rotate": "Change this output's level",
          "Push": "Match the main level",
          "Touch": "Match the main level"
        }
      },
      "States": [
        {
          "Image": "imgs/keys/channel",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "Faders set",
      "UUID": "com.minimalhandle.sleekmeeter.mixfor",
      "Icon": "imgs/actions/route",
      "Tooltip": "Voicemeeter Potato: press to make the input faders set one output's mix (Voicemeeter's output select). Press again for every output.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/pi.html",
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/keys/route",
          "ShowTitle": false
        }
      ]
    }
  ]
}
